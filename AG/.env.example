# Google Cloud Project Details
GCP_PROJECT_NUMBER=123456789012
GCP_LOCATION=global
GCP_ENDPOINT_LOCATION=us

# OAuth2 Access Token (generate via: gcloud auth print-access-token)
GCP_ACCESS_TOKEN=your_mock_access_token_here

# Mode of operation: 'live' or 'mock'
DEFAULT_MODE=mock

# Enable verbose logging of exact requests, responses, and curl commands
VERBOSE_LOGGING=True
