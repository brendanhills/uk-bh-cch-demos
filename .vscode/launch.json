    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Current File Main with sample",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "-i", "GOTOES_big_sample.gpx",
                "-o", " GOTOES_big_sample_compressed.gpx"
            ]
        },
    {
        "name": "Python: Current File Main with full files",
        "type": "python",
        "request": "launch",
        "program": "${file}",
        "console": "integratedTerminal",
        "justMyCode": true,
        "args": [
            "-i", "GOTOES_big.gpx",
            "-o", "GOTOES_big_compressed.gpx"
        ]
    }
    ]
}