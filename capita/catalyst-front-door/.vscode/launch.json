{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Python File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}"
        },
        {
            "name": "adk web",
            "type": "debugpy",
            "request": "launch",
            "module": "google.adk.cli",
            "cwd": "${workspaceFolder}/",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false,
            "args": [
                "web",
                "--no-reload",
                "--log_level",
                "debug",
            ]
        },
        {
            "name": "adk run",
            "type": "debugpy",
            "request": "launch",
            "module": "google.adk.cli",
            "cwd": "${workspaceFolder}/",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false,
            "args": [
                "run",
                "${fileDirname}",
            ]
        },
        {
           "name": "Python Debugger: ADK Web",
           "type": "debugpy",
           "request": "launch",
           "program": "${workspaceFolder}/.venv/bin/adk",
           "args": ["web"],
           "python": "${workspaceFolder}/.venv/bin/python",
           "console": "integratedTerminal",
           "cwd": "${workspaceFolder}"
       }

    ]
}