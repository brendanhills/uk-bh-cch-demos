# proto-file: learning/gemini/agents/evaluation/evalin/proto/eval_suite.proto
# proto-message: EvalSuite
# txtpbfmt: wrap_strings_after_newlines

suite_name: "spec_drift_detector"
timeout_seconds: 300

# Common files staged for all cases if needed, but we can also stage them per case.
# We stage the config file and the spec file in all cases.

cases {
  name: "missing_config_graceful_exit"
  prompt: "Review changes for file `net/slo/dummy_code_missing.cc` with spec `net/slo/l3/missing_spec_mappings.json`. Run `diff net/slo/dummy_code_missing.cc.before net/slo/dummy_code_missing.cc` to see the diff."

  setup {
    files {
      key: "net/slo/dummy_code_missing.cc.before"
      value: "int get_val() { return 5; }\n"
    }
    files {
      key: "net/slo/dummy_code_missing.cc"
      value: "int get_val() { return -5; }\n"
    }
  }

  expectations: "Agent invokes the subagent to perform relevance filtering."
  expectations: "Subagent encounters an error because the config file is missing."
  expectations: "Agent terminates execution and does NOT post warning comments on the CL."
}

cases {
  name: "some_mapped_no_drift"
  prompt: "Review changes for files `net/slo/l3/c1_file_a.cc` and `net/slo/l3/c1_file_b.cc` with spec `net/slo/l3/spec_mappings_c1.json`. Run `diff net/slo/l3/c1_file_a.cc.before net/slo/l3/c1_file_a.cc` and `diff net/slo/l3/c1_file_b.cc.before net/slo/l3/c1_file_b.cc` to see the diffs."

  setup {
    files {
      key: "net/slo/l3/spec_mappings_c1.json"
      value:
        "{\n"
        "  \"mappings\": [\n"
        "    {\n"
        "      \"spec\": \"net/slo/g3doc/infrastructure/l3/spec_c1_a.md\",\n"
        "      \"files\": [\n"
        "        \"net/slo/l3/c1_file_a.cc\"\n"
        "      ]\n"
        "    }\n"
        "  ]\n"
        "}\n"
    }
    files {
      key: "net/slo/g3doc/infrastructure/l3/spec_c1_a.md"
      value:
        "# Spec C1 A\n"
        "The value must always be greater than 0 and less than 11.\n"
    }
    files {
      key: "net/slo/l3/c1_file_a.cc.before"
      value:
        "int get_val() {\n"
        "  return 5;\n"
        "}\n"
    }
    files {
      key: "net/slo/l3/c1_file_a.cc"
      value:
        "// Increased default value\n"
        "int get_val() {\n"
        "  return 10;\n"
        "}\n"
    }
    files {
      key: "net/slo/l3/c1_file_b.cc.before"
      value:
        "void log_info() {\n"
        "  // do nothing\n"
        "}\n"
    }
    files {
      key: "net/slo/l3/c1_file_b.cc"
      value:
        "void log_info() {\n"
        "  // Added print statement\n"
        "  std::cout << \"info\";\n"
        "}\n"
    }
  }

  expectations: "Agent filtering identifies that only net/slo/l3/c1_file_a.cc is mapped to a spec, and net/slo/l3/c1_file_b.cc is filtered out."
  expectations: "Agent identifies that the change in net/slo/l3/c1_file_a.cc does not violate the spec ('must always be greater than 0 and less than 11')."
  expectations: "Agent outputs NO_DRIFT."
  expectations: "Agent does NOT leave any warning comment."
}

cases {
  name: "some_mapped_some_drift"
  prompt: "Review changes for files `net/slo/l3/c2_file_a.cc`, `net/slo/l3/c2_file_b.cc` and `net/slo/l3/c2_file_c.cc` with spec `net/slo/l3/spec_mappings_c2.json`. Run `diff net/slo/l3/c2_file_a.cc.before net/slo/l3/c2_file_a.cc`, `diff net/slo/l3/c2_file_b.cc.before net/slo/l3/c2_file_b.cc` and `diff net/slo/l3/c2_file_c.cc.before net/slo/l3/c2_file_c.cc` to see the diffs."

  setup {
    files {
      key: "net/slo/l3/spec_mappings_c2.json"
      value:
        "{\n"
        "  \"mappings\": [\n"
        "    {\n"
        "      \"spec\": \"net/slo/g3doc/infrastructure/l3/spec_c2_a.md\",\n"
        "      \"files\": [\n"
        "        \"net/slo/l3/c2_file_a.cc\"\n"
        "      ]\n"
        "    },\n"
        "    {\n"
        "      \"spec\": \"net/slo/g3doc/infrastructure/l3/spec_c2_b.md\",\n"
        "      \"files\": [\n"
        "        \"net/slo/l3/c2_file_b.cc\"\n"
        "      ]\n"
        "    }\n"
        "  ]\n"
        "}\n"
    }
    files {
      key: "net/slo/g3doc/infrastructure/l3/spec_c2_a.md"
      value:
        "# Spec C2 A\n"
        "The value must always be greater than 0 and less than 11.\n"
    }
    files {
      key: "net/slo/g3doc/infrastructure/l3/spec_c2_b.md"
      value:
        "# Spec C2 B\n"
        "The helper function must be thread-safe.\n"
    }
    files {
      key: "net/slo/l3/c2_file_a.cc.before"
      value:
        "int get_val() {\n"
        "  return 5;\n"
        "}\n"
    }
    files {
      key: "net/slo/l3/c2_file_a.cc"
      value:
        "int get_val() {\n"
        "  return -5; // VIOLATION: returns negative\n"
        "}\n"
    }
    files {
      key: "net/slo/l3/c2_file_b.cc.before"
      value:
        "void run_task() {\n"
        "  // lock mutex\n"
        "}\n"
    }
    files {
      key: "net/slo/l3/c2_file_b.cc"
      value:
        "void run_task() {\n"
        "  // lock mutex\n"
        "  // perform task (still thread-safe)\n"
        "}\n"
    }
    files {
      key: "net/slo/l3/c2_file_c.cc.before"
      value: "void helper() {}\n"
    }
    files {
      key: "net/slo/l3/c2_file_c.cc"
      value:
        "void helper() {\n"
        "  // Changed helper\n"
        "}\n"
    }
  }

  expectations: "Agent filtering identifies that net/slo/l3/c2_file_a.cc and net/slo/l3/c2_file_b.cc are mapped to specs, and net/slo/l3/c2_file_c.cc is filtered out."
  expectations: "Agent identifies that net/slo/l3/c2_file_a.cc violates its spec, and net/slo/l3/c2_file_b.cc does not."
  expectations: "Agent leaves a warning comment about Spec Drift on net/slo/l3/c2_file_a.cc."
  expectations: "Agent does NOT leave a warning comment on net/slo/l3/c2_file_b.cc or net/slo/l3/c2_file_c.cc."
}

cases {
  name: "some_mapped_all_drift"
  prompt: "Review changes for files `net/slo/l3/c3_file_a.cc`, `net/slo/l3/c3_file_b.cc` and `net/slo/l3/c3_file_c.cc` with spec `net/slo/l3/spec_mappings_c3.json`. Run `diff net/slo/l3/c3_file_a.cc.before net/slo/l3/c3_file_a.cc`, `diff net/slo/l3/c3_file_b.cc.before net/slo/l3/c3_file_b.cc` and `diff net/slo/l3/c3_file_c.cc.before net/slo/l3/c3_file_c.cc` to see the diffs."

  setup {
    files {
      key: "net/slo/l3/spec_mappings_c3.json"
      value:
        "{\n"
        "  \"mappings\": [\n"
        "    {\n"
        "      \"spec\": \"net/slo/g3doc/infrastructure/l3/spec_c3_a.md\",\n"
        "      \"files\": [\n"
        "        \"net/slo/l3/c3_file_a.cc\"\n"
        "      ]\n"
        "    },\n"
        "    {\n"
        "      \"spec\": \"net/slo/g3doc/infrastructure/l3/spec_c3_b.md\",\n"
        "      \"files\": [\n"
        "        \"net/slo/l3/c3_file_b.cc\"\n"
        "      ]\n"
        "    }\n"
        "  ]\n"
        "}\n"
    }
    files {
      key: "net/slo/g3doc/infrastructure/l3/spec_c3_a.md"
      value:
        "# Spec C3 A\n"
        "The value must always be greater than 0 and less than 11.\n"
    }
    files {
      key: "net/slo/g3doc/infrastructure/l3/spec_c3_b.md"
      value:
        "# Spec C3 B\n"
        "The helper function must be thread-safe.\n"
    }
    files {
      key: "net/slo/l3/c3_file_a.cc.before"
      value:
        "int get_val() {\n"
        "  return 5;\n"
        "}\n"
    }
    files {
      key: "net/slo/l3/c3_file_a.cc"
      value:
        "int get_val() {\n"
        "  return -5; // VIOLATION: returns negative\n"
        "}\n"
    }
    files {
      key: "net/slo/l3/c3_file_b.cc.before"
      value:
        "void run_task() {\n"
        "  absl::MutexLock lock(&mu_);\n"
        "}\n"
    }
    files {
      key: "net/slo/l3/c3_file_b.cc"
      value:
        "void run_task() {\n"
        "  // Removed lock, VIOLATION: not thread-safe\n"
        "}\n"
    }
    files {
      key: "net/slo/l3/c3_file_c.cc.before"
      value: "void helper() {}\n"
    }
    files {
      key: "net/slo/l3/c3_file_c.cc"
      value:
        "void helper() {\n"
        "  // Changed helper\n"
        "}\n"
    }
  }

  expectations: "Agent filtering identifies that net/slo/l3/c3_file_a.cc and net/slo/l3/c3_file_b.cc are mapped to specs, and net/slo/l3/c3_file_c.cc is filtered out."
  expectations: "Agent identifies that both net/slo/l3/c3_file_a.cc and net/slo/l3/c3_file_b.cc violate their specs."
  expectations: "Agent leaves warning comments about Spec Drift on both net/slo/l3/c3_file_a.cc and net/slo/l3/c3_file_b.cc."
  expectations: "Agent does NOT leave a warning comment on net/slo/l3/c3_file_c.cc."
}

