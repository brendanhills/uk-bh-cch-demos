}

cases {
  name: "frontmatter_spec_discovery_drift"
  prompt: "Review changes for file `net/slo/l3/fm_drift/fm_file_drift.cc`. Run `diff net/slo/l3/fm_drift/fm_file_drift.cc.before net/slo/l3/fm_drift/fm_file_drift.cc` to see the diff. Detect any spec drift."

  setup {
    files {
      key: "net/slo/l3/fm_drift/fm_drift_spec.md"
      value:
        "---\n"
        "name: fm-drift-spec\n"
        "description: Frontmatter specification for drift detection\n"
        "files:\n"
        "  - \"*.cc\"\n"
        "---\n"
        "# FM Drift Specification\n"
        "The Frame Header is exactly 24 bytes.\n"
    }
    files {
      key: "net/slo/l3/fm_drift/fm_file_drift.cc.before"
      value: "const size_t kFrameHeaderSize = 24;\n"
    }
    files {
      key: "net/slo/l3/fm_drift/fm_file_drift.cc"
      value: "const size_t kFrameHeaderSize = 28;\n"
    }
  }

  expectations: "Agent discovers the frontmatter specification net/slo/l3/fm_drift/fm_drift_spec.md."
  expectations: "Agent detects specification drift because kFrameHeaderSize was changed from 24 to 28 while the spec defines it as 24."
  expectations: "Agent leaves a warning comment about Spec Drift on net/slo/l3/fm_drift/fm_file_drift.cc."
}

cases {
  name: "frontmatter_spec_discovery_no_drift"
  prompt: "Review changes for file `net/slo/l3/fm_nodrift/fm_file_nodrift.cc`. Run `diff net/slo/l3/fm_nodrift/fm_file_nodrift.cc.before net/slo/l3/fm_nodrift/fm_file_nodrift.cc` to see the diff. Detect any spec drift."

  setup {
    files {
      key: "net/slo/l3/fm_nodrift/fm_nodrift_spec.md"
      value:
        "---\n"
        "name: fm-nodrift-spec\n"
        "description: Frontmatter specification for no-drift verification\n"
        "files:\n"
        "  - \"*.cc\"\n"
        "---\n"
        "# FM No Drift Specification\n"
        "The Frame Header is exactly 24 bytes.\n"
    }
    files {
      key: "net/slo/l3/fm_nodrift/fm_file_nodrift.cc.before"
      value: "const size_t kFrameHeaderSize = 24;\n"
    }
    files {
      key: "net/slo/l3/fm_nodrift/fm_file_nodrift.cc"
      value:
        "// Harmless test comment\n"
        "const size_t kFrameHeaderSize = 24;\n"
    }
  }

  expectations: "Agent discovers the frontmatter specification net/slo/l3/fm_nodrift/fm_nodrift_spec.md."
  expectations: "Agent identifies that the change is only an innocuous comment addition."
  expectations: "Agent outputs NO_DRIFT."
  expectations: "Agent does NOT leave any warning comments."
}
